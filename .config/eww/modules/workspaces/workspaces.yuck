(deflisten workspace-focused
  :initial "0"
  "scripts/workspace-focused.sh")

(deflisten workspace-occupied
	"scripts/workspace-occupied.sh")

(defwidget workspace-item [id]
  (button 
    :orientation "h"
    :class {workspace-focused == id ? "workspace-item active" : workspace-occupied =~ "\\b${id}\\b" ? "workspace-item occupied" : "workspace-item"}
    :valign "center"
	  :onclick "bspwm-slidefx -w ${id}"
  )
)

(defwidget workspaces []
  (eventbox
    :onscroll "[ '{}' = 'down' ] && bspwm-slidefx -w prev || bspwm-slidefx -w next"
    (box 
      :class "workspaces"
      :orientation "h"
      :space-evenly false
      :spacing 4
      (workspace-item :id "1")
      (workspace-item :id "2")
      (workspace-item :id "3")
      (workspace-item :id "4")
      (workspace-item :id "5")
    )
  )
)
