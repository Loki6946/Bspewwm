(deflisten network-data
  :initial '{"essid": "lo", "signal": "", "radio": "enabled"}'
  "scripts/network.sh"
)

(defvar network-popup-open false)
(defvar network-radio-optimistic true)

(defvar network-notif-open false)
(defvar network-notif-message "")
(defvar network-notif-icon "wifi")

(defwidget network []
  (box
    :orientation "h"
    :halign "center"
    (button 
      :class "network-trigger"
      :halign "center"
      :onclick "scripts/network-popup-toggle.sh"
      (label
        :class "network-trigger-icon"
        :text {network-data.essid == "lo" ? "" : network-data.signal == "" ? "" : network-data.signal < 25 ? "" : network-data.signal < 50 ? "" : network-data.signal < 75 ? "" : ""}
      )
    )
  )
)

(defwidget switch [onclick]
  (eventbox
    :cursor "pointer"
    :onclick "${onclick} & eww update network-radio-optimistic=${!network-radio-optimistic}"
    (box
      :class {network-radio-optimistic ? "switch switch-on" : "switch switch-off"}
      :valign "center"
      (box 
        :class "switch-thumb"
        (label
          :class "switch-thumb-label"
          :visible {network-radio-optimistic}
          :text ""
        )
      )
    )
  )
)

(defwindow network-popup
  :monitor 0
  :geometry (geometry
    :x "-5px"
    :y "36px"
    :width "220px"
    :height "0px"
    :anchor "top right")
  :stacking "fg"
  (network-popup-widget))

(defwidget network-popup-widget []
  (box
    :class "network-popup-box"
    :orientation "v"
    :space-evenly false
    :spacing 15
    ; header
    (box
      :orientation "h"
      :halign "fill"
      :valign "center"
      :space-evenly false
      (label
        :class "network-popup-title"
        :halign "start"
        :hexpand true
        :text "Wi-Fi"
      )
      (switch
        :state {network-data.radio == "enabled"}
        :onclick "scripts/network-radio-toggle.sh"
      )
    )
    ; connection info
    (stack
      :selected {network-data.radio == "enabled" ? 0 : 1}
      :transition "crossfade"
      :same-size false
      (box
        :class "network-popup-info"
        :orientation "h"
        :space-evenly false
        :spacing 10
        :visible {network-data.radio == "enabled"}
        (label
          :class "network-popup-signal"
          :text {network-data.essid == "lo" ? "" : network-data.signal == "" ? "" : network-data.signal < 25 ? "" : network-data.signal < 50 ? "" : network-data.signal < 75 ? "" : ""}
        )
        (box
          :orientation "v"
          :hexpand true
          (label
            :class "network-popup-ssid"
            :text {network-data.essid == "lo" ? "Not connected" : network-data.essid}
            :halign "start"
            :truncate true
            :limit-width 20
          )
          (label
            :class "network-popup-status"
            :text {network-data.essid == "lo" ? "" : "Connected"}
            :halign "start"
          )
        )
      )
      ; wifi off message
      (label
        :class "network-popup-status-off"
        :text "Wi-Fi is turned off"
        :halign "center"
        :visible {network-data.radio == "disabled"}
      )
    )
  ) 
)

(defwindow network-notif
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "-36px"
    :width "280px"
    :height "0px"
    :anchor "bottom center")
  :stacking "fg"
  (network-notif-widget))

(defwidget network-notif-widget []
  (box
    :orientation "h"
    :space-evenly false
    :spacing 20
    (box
      :orientation "h"
      :space-evenly false
      :hexpand true
      :spacing 8
      (label
        :class "network-notif-icon"
        :text {network-notif-icon}
      )
      (label
        :class "network-notif-text"
        :text {network-notif-message}
      )
    )
    (button
      :class "network-notif-close-btn"
      :halign "end"
      :onclick "scripts/network-notif-close.sh"
      (label
        :class "network-notif-close-text"
        :text "Close"
      )
    )
  )
)