(deflisten network-data
  :initial '{"essid": "lo", "signal": ""}'
  `scripts/network.sh`
)

(defwidget network []
  (box
    :halign "center"
    :orientation "h"
    (button 
      :class "network-button"
      :orientation "h"
      (label
        :class "network-label"
        :text {network-data.essid == "lo" ? "" : network-data.signal == "" ? "" : network-data.signal < 25 ? "" : network-data.signal < 50 ? "" : network-data.signal < 75 ? "" : ""}
      )
    )
  )
)