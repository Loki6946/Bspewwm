(defwidget color-picker []
  (box
    :orientation "h"
    :halign "center"
    (button 
      :class "color-picker-button"
      :orientation "h"
      :onclick "gpick -p -s -o | xclip -selection clipboard" 
      (label
        :class "color-picker-label"
        :yalign 0.6
        :text ""
      )
    )
  )
)