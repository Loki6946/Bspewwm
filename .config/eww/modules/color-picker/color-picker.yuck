(defwidget color-picker []
  (box
    :orientation "h"
    :halign "center"
    (button 
      :class "color-picker-trigger"
      :orientation "h"
      :halign "center"
      :onclick "gpick -p -s -o | xclip -selection clipboard" 
      (label
        :class "color-picker-trigger-icon"
        :text ""
      )
    )
  )
)