(defpoll sysinfo
  :interval "30s"
  :initial '{"cpu_name": "", "gpu_name": "", "os": "", "kernel": "", "total_ram": "", "uptime": ""}'
  "scripts/sysinfo.sh")

(defvar sysinfo-popup-open false)
(defvar sysinfo-toggle false)

(defwidget sysinfo []
  (box
    :orientation "h"
    :halign "center"
    (button 
      :class "sysinfo-trigger"
      :orientation "h"
      :valign "center"
      :halign "center"
      :onclick "scripts/sysinfo-popup-toggle.sh" 
      (label
        :class "sysinfo-trigger-icon"
        :text ""
      )
    )
  )
)

(defwindow sysinfo-popup
  :monitor 0
  :geometry (geometry
    :x "5px"     
    :y "36px"     
    :width "250px"
    :height "0px"
    :anchor "top left")
  :stacking "fg"
  (sysinfo-popup-widget)
)

(defwidget sysinfo-popup-widget []
  (box
    :orientation "v"
    :space-evenly false
    (box
      :class "sysinfo-popup-header"
      :orientation "h"
      :valign "center"
      :halign "start"
      (label
        :class "sysinfo-popup-header-text"
        :text "System"
      )
    )
    (box
      :class "sysinfo-popup-usage"
      :orientation "v"
      :spacing 3
      (box
        :class "sysinfo-popup-info start"
        :orientation "h"
        (label
          :class "sysinfo-popup-name"
          :halign "start"
          :text "CPU"
        )
        (label
          :class "sysinfo-popup-value"
          :halign "end"
          :text "${round(EWW_CPU.avg, 0)}%"
        )
      )
      (box
        :class "sysinfo-popup-info"
        :orientation "h"
        (label
          :class "sysinfo-popup-name"
          :halign "start"
          :text "Memory"
        )
        (label
          :class "sysinfo-popup-value"
          :halign "end"
          :text "${round(EWW_RAM.used_mem_perc, 0)}%"
        )
      )
      (box
        :class "sysinfo-popup-info end"
        :orientation "h"
        (label
          :class "sysinfo-popup-name"
          :halign "start"
          :text "Uptime"
        )
        (label
          :class "sysinfo-popup-value"
          :halign "end"
          :text {sysinfo.uptime}
        )
      )
    )
    (box
      :class "sysinfo-popup-system"
      :orientation "v"
      :spacing 3
      (box
        :class "sysinfo-popup-info start"
        :orientation "v"
        (label
          :class "sysinfo-popup-name"
          :halign "start"
          :text "CPU"
        )
        (label
          :class "sysinfo-popup-value"
          :halign "start"
          :text {sysinfo.cpu_name}
        )
      )
      (box
        :class "sysinfo-popup-info"
        :orientation "v"
        (label
          :class "sysinfo-popup-name"
          :halign "start"
          :text "GPU"
        )
        (label
          :class "sysinfo-popup-value"
          :halign "start"
          :text {sysinfo.gpu_name}
        )
      )
      (box
        :class "sysinfo-popup-info"
        :orientation "v"
        (label
          :class "sysinfo-popup-name"
          :halign "start"
          :text "Memory"
        )
        (label
          :class "sysinfo-popup-value"
          :halign "start"
          :text {sysinfo.total_ram}
        )
      )
      (box
        :class "sysinfo-popup-info"
        :orientation "v"
        (label
          :class "sysinfo-popup-name"
          :halign "start"
          :text "OS"
        )
        (label
          :class "sysinfo-popup-value"
          :halign "start"
          :text {sysinfo.os}
        )
      )
      (box
        :class "sysinfo-popup-info end"
        :orientation "v"
        (label
          :class "sysinfo-popup-name"
          :halign "start"
          :text "Kernel"
        )
        (label
          :class "sysinfo-popup-value"
          :halign "start"
          :text {sysinfo.kernel}
        )
      )
    )
  )
)