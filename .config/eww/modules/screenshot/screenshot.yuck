(defvar screenshot-popup-open false)
(defvar screenshot-delay 1)

(defpoll screen-recording
  :interval "9999s"
  :initial false
  "cat ~/.cache/eww/screen-recording 2>/dev/null || echo false")

(defwidget screenshot []
  (box
    :orientation "h"
    (button 
      :class "screenshot-trigger"
      :onclick "scripts/screenshot-popup-toggle.sh" 
      (label
        :class {screen-recording ? "screenshot-trigger-icon recording" : "screenshot-trigger-icon"}
        :text {screen-recording ? "" : ""}
      )
    )
  )
)

(defwindow screenshot-popup
  :monitor 0
  :geometry (geometry
    :x "0px"     
    :y "-36px"     
    :width "0px"
    :height "0px"
    :anchor "bottom center")
  :stacking "fg"
  (screenshot-popup-widget)
)

(defwidget screenshot-popup-widget []
  (box
    :orientation "h"
    :space-evenly false
    :spacing 8
    (box
      :class "screenshot-popup-background"
      :orientation "h"
      :space-evenly false
      :spacing 4
      (box
        :orientation "h"
        :space-evenly true
        :spacing 4
        (button
          :class "screenshot-popup-action-btn"
          :tooltip "Screen"
          :onclick "scripts/screenshot.sh full & scripts/screenshot-popup-toggle.sh"
          (label
            :class "screenshot-popup-action-icon"
            :text ""
          )
        )
        (button
          :class "screenshot-popup-action-btn"
          :tooltip "Region"
          :onclick "scripts/screenshot.sh selection & scripts/screenshot-popup-toggle.sh"
          (label
            :class "screenshot-popup-action-icon"
            :text ""
          )
        )
        (button
          :class "screenshot-popup-action-btn"
          :tooltip "Delay"
          :onclick "scripts/screenshot-cycle-delay.sh"
          (label
            :class {screenshot-delay == 1 ? "screenshot-popup-action-icon" : "screenshot-popup-action-text"}
            :text {screenshot-delay == 1 ? "" : "${screenshot-delay}s"}
          )
        )
      )
      (box
        :class "screenshot-popup-btn-separator"
        :valign "center"
      )
      (button
        :class {screen-recording ? "screenshot-popup-action-btn recording" : "screenshot-popup-action-btn"}
        :tooltip {screen-recording ? "Stop Recording" : "Record"}
        :onclick "scripts/screenrecord.sh"
        (label
          :class "screenshot-popup-action-icon"
          :text {screen-recording ? "" : ""}
        )
      )
    )
    (box
      :class "screenshot-popup-background-alt"
      :valign "center"
      :space-evenly false
      (button
        :class "screenshot-popup-action-btn-alt"
        :onclick "scripts/screenshot-popup-toggle.sh"
        (label
          :class "screenshot-popup-action-icon-alt"
          :text ""
        )
      )
    )
  )
)