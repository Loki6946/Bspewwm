(deflisten keyboard-layout
  :initial "us"
  "scripts/get-kb-layout.sh"
)

(defwidget keyboard []
  (box
    :orientation "h"
    :halign "center"
    (button 
      :class "keyboard-button"
      :orientation "h"
      (box
        :orientation "h"
        :spacing 2
        (label
          :class "keyboard-icon"
          :text ""
        )
        (label
          :class "keyboard-label"
          :text {keyboard-layout}
        )
      )
    )
  )
)