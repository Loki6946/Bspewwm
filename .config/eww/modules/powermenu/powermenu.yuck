(defvar power-popup-open false)
(defvar power-pending-action "")
(defvar power-pending-name "")

; powermenu icon on bar
(defwidget powermenu []
  (box 
    :orientation "h"
    :halign "center"
    (button 
      :class "power-trigger"
      :orientation "h"
      :valign "center"
      :halign "center"
      :onclick "scripts/power-popup-toggle.sh"
      (label
        :class "power-trigger-icon"
        :text ""
      )
    )
  )
)

(defwidget power-popup-btn [action name icon]
  (box
    :orientation "v"
    :space-evenly false
    :spacing 10
    (button
      :onclick "scripts/power-select.sh '${action}' '${name}'"
      (box
        :class {power-pending-name == name ? "power-popup-btn power-popup-btn--pending" : "power-popup-btn"}
        (label
          :class "power-popup-btn-icon"
          :text {power-pending-name == name ? "" : icon}
        )
      )
    )
    (label
      :class "power-popup-btn-text"
      :text name
    )
  )
)

; powermenu popup window
(defwindow power-popup
  :monitor 0
  :geometry (geometry
    :x "0px"     
    :y "0px"     
    :width "200px"
    :height "0"
    :anchor "center")
  :stacking "fg"
  (power-popup-widget)
)

; powermenu popup content

(defwidget power-popup-widget []
  (box
    :orientation "v"
    :space-evenly false
    :spacing 20
    (box
      :orientation "h"
      :spacing 25
      (power-popup-btn :action "systemctl poweroff" :name "Power" :icon "")
      (power-popup-btn :action "systemctl reboot" :name "Reboot" :icon "")
    )
    (box
      :orientation "h"
      :spacing 25
      (power-popup-btn :action "systemctl suspend" :name "Sleep" :icon "")
      (power-popup-btn :action "bspc quit" :name "Exit" :icon "")
    )
  )
)