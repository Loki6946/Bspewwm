(defvar power-popup-open false)
(defvar power-confirm-open false)
(defvar power-pending-action "")
(defvar power-pending-name "")

; powermenu icon on bar
(defwidget powermenu []
  (box 
    :orientation "h"
    :halign "center"
    (button 
      :class "power-trigger"
      :orientation "h"
      :valign "center"
      :halign "center"
      :onclick "scripts/power-popup-toggle.sh"
      (label
        :class "power-trigger-icon"
        :text ""
      )
    )
  )
)

; powermenu popup window
(defwindow power-popup
  :monitor 0
  :geometry (geometry
    :x "5px"     
    :y "36px"     
    :width "250px"
    :height "0px"
    :anchor "top left")
  :stacking "fg"
  (power-popup-widget)
)

; powermenu popup content
(defwidget power-popup-widget []
  (revealer
    :reveal power-popup-open
    :transition "slidedown" 
    :duration "250ms"
    (box
      :orientation "h"
      :space-evenly true
      :halign "center"
      :spacing 5

      ; poweroff button
      (button
        :class "power-popup-button"
        :onclick "scripts/power-select.sh 'systemctl poweroff' 'Power Off'"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "power-popup-icon"
            :text ""
          )
          (label
            :class "power-popup-text"
            :text "Power"
          )
        )
      )

      ; reboot button
      (button
        :class "power-popup-button"
        :onclick "scripts/power-select.sh 'systemctl reboot' 'Reboot'"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "power-popup-icon"
            :text ""
          )
          (label
            :class "power-popup-text"
            :text "Reboot"
          )
        )
      )

      ; sleep button
      (button
        :class "power-popup-button"
        :onclick "scripts/power-select.sh 'systemctl suspend' 'Sleep'"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "power-popup-icon"
            :text ""
          )
          (label
            :class "power-popup-text"
            :text "Sleep"
          )
        )
      )

      ; exit bspwm button
      (button
        :class "power-popup-button"
        :onclick "scripts/power-select.sh 'bspc quit' 'Exit'"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "power-popup-icon"
            :text ""
          )
          (label
            :class "power-popup-text"
            :text "Exit"
          )
        )
      )
    )
  )
)

; powermenu confirmation window
(defwindow power-confirm
  :monitor 0
  :geometry (geometry
    :x "5px"
    :y "36px"
    :width "250px"
    :height "0px"
    :anchor "top left")
  :stacking "fg"
  (power-confirm-widget)
)

; powermenu confirmation content
(defwidget power-confirm-widget []
  (revealer
    :reveal power-confirm-open
    :transition "slidedown"
    :duration "250ms"
    (box
      :orientation "v"
      :class "power-confirm-box"
      :halign "fill"
      :space-evenly false
      :spacing 20

      ; message box
      (box
        :orientation "v"
        :halign "start"
        :spacing 8
        (label
          :class "power-confirm-text-title"
          :halign "start"
          :text "Are you sure?"
        )
        (label
          :class "power-confirm-text-description"
          :halign "start"
          :text {power-pending-name == "Sleep" ? "Any unsaved changes will be saved." : "Any unsaved changes will be lost."}
        )
      )

      ; action buttons
      (box
        :orientation "h"
        :halign "end"
        :space-evenly false
        :spacing 5
        (button
          :class "power-confirm-btn cancel"
          :halign "end"
          :onclick "scripts/power-cancel.sh"
          "Cancel"
        )
        (button
          :class "power-confirm-btn confirm"
          :halign "end"
          :onclick "scripts/power-execute.sh"
          "${power-pending-name}"
        )
      )
    )
  )
)