(defvar pow-popup-open false)
(defvar pow-confirm-open false)
(defvar pow-pending-action "")
(defvar pow-pending-name "")

; powermenu icon on bar
(defwidget powermenu []
  (box 
    :class "power-widget"
    :halign "center"
    :orientation "h"
    (button 
      :class "power-button"
      :orientation "h"
      :onclick "scripts/pow-popup-toggle.sh"
      (label
        :class "power-label"
        :text ""
      )
    )
  )
)

; powermenu popup window
(defwindow pow-popup
  :monitor 0
  :geometry (geometry
    :x "5px"     
    :y "36px"     
    :width "250px"
    :height "0px"
    :anchor "top left")
  :stacking "fg"
  (pow-popup-widget)
)

; powermenu popup content
(defwidget pow-popup-widget []
  (revealer
    :reveal pow-popup-open
    :transition "slidedown" 
    :duration "200ms"
    (box
      :orientation "h"
      :space-evenly true
      :halign "center"
      :spacing 10

      ; poweroff button
      (button
        :class "pow-popup-button"
        :onclick "scripts/pow-select.sh 'systemctl poweroff' 'Power Off'"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "pow-popup-icon"
            :text ""
          )
          (label
            :class "pow-popup-text"
            :text "Power"
          )
        )
      )

      ; reboot button
      (button
        :class "pow-popup-button"
        :onclick "scripts/pow-select.sh 'systemctl reboot' 'Reboot'"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "pow-popup-icon"
            :text ""
          )
          (label
            :class "pow-popup-text"
            :text "Reboot"
          )
        )
      )

      ; sleep button
      (button
        :class "pow-popup-button"
        :onclick "scripts/pow-select.sh 'systemctl suspend' 'Sleep'"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "pow-popup-icon"
            :text ""
          )
          (label
            :class "pow-popup-text"
            :text "Sleep"
          )
        )
      )

      ; exit bspwm button
      (button
        :class "pow-popup-button"
        :onclick "scripts/pow-select.sh 'bspc quit' 'Exit'"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "pow-popup-icon"
            :text ""
          )
          (label
            :class "pow-popup-text"
            :text "Exit"
          )
        )
      )
    )
  )
)

; powermenu confirmation window
(defwindow pow-confirm
  :monitor 0
  :geometry (geometry
    :x "5px"
    :y "36px"
    :width "200px"
    :height "0px"
    :anchor "top left")
  :stacking "fg"
  (pow-confirm-widget)
)

; powermenu confirmation content
(defwidget pow-confirm-widget []
  (revealer
    :reveal pow-confirm-open
    :transition "slidedown"
    :duration "200ms"
    (box
      :class "pow-confirm-box"
      :orientation "v"
      :spacing 15
      :halign "center"

      ; message box
      (box
        :orientation "v"
        :halign "center"
        :spacing 5
        (label
          :class "pow-confirm-text-head"
          :text "Are you sure?"
        )
        (label
          :class "pow-confirm-text-desc"
          :text {pow-pending-name == "Sleep" ? "Any unsaved changes will be saved." : "Any unsaved changes will be lost."}
        )
      )

      ; action buttons
      (box
        :orientation "h"
        :spacing 8
        :halign "center"
        :space-evenly true
        (button
          :class "pow-confirm-yes"
          :onclick "scripts/pow-execute.sh"
          "${pow-pending-name}"
        )
        (button
          :class "pow-confirm-no"
          :onclick "scripts/pow-cancel.sh"
          "Cancel"
        )
      )
    )
  )
)