(defvar pow-popup-open false)

(defwidget powermenu []
  (box 
    :class "power-widget"
    :halign "center"
    :orientation "h"
    (button 
      :class "power-button"
      :orientation "h"
      :onclick `scripts/toggle-pow-popup.sh`
      (label
        :class "power-label"
        :text ""
      )
    )
  )
)

(defwindow pow-popup
  :monitor 0
  :geometry (geometry
    :x "5px"     
    :y "36px"     
    :width "250px"
    :height "0px"
    :anchor "top left")
  :stacking "fg"
  (pow-popup-widget))

(defwidget pow-popup-widget []
  (revealer
    :reveal pow-popup-open
    :transition "slidedown" 
    :duration "200ms"
    (box
      :orientation "h"
      :space-evenly true
      :halign "center"
      :spacing 10
      (button
        :class "pow-popup-button"
        :onclick "scripts/toggle-pow-popup.sh && systemctl poweroff"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "pow-popup-icon"
            :text ""
          )
          (label
            :class "pow-popup-text"
            :text "Power"
          )
        )
      )
      (button
        :class "pow-popup-button"
        :onclick "scripts/toggle-pow-popup.sh && systemctl reboot"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "pow-popup-icon"
            :text ""
          )
          (label
            :class "pow-popup-text"
            :text "Reboot"
          )
        )
      )
      (button
        :class "pow-popup-button"
        :onclick "scripts/toggle-pow-popup.sh && systemctl suspend"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "pow-popup-icon"
            :text ""
          )
          (label
            :class "pow-popup-text"
            :text "Sleep"
          )
        )
      )
      (button
        :class "pow-popup-button"
        :onclick "scripts/toggle-pow-popup.sh && bspc quit"
        (box
          :orientation "v"
          :space-evenly false
          :valign "center"
          :spacing 5
          (label
            :class "pow-popup-icon"
            :text ""
          )
          (label
            :class "pow-popup-text"
            :text "Exit"
          )
        )
      )
    )
  )
)