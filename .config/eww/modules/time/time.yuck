(defpoll datetime
  :interval "10s"
  "date '+{\"time\":\"%H:%M\",\"date\":\"%A,  %B %e,  %Y\"}'"
)

(defvar calendar-popup-open false)

(defwidget time []
  (box 
    :orientation "h"
    :halign "center"
    :hexpand true
    (button 
      :class "time-trigger"
      :orientation "h"
      :onclick "scripts/calendar-toggle.sh"
      (label
        :class "time-trigger-text"
        :text {datetime.time}
      )
    )
  )
)

(defwindow calendar-popup
  :monitor 0
  :geometry (geometry
    :x "-5px"
    :y "36px"
    :width "220px"
    :anchor "top right")
  :stacking "fg"
  (calendar-popup-widget)
)

(defwidget calendar-popup-widget []
  (revealer
    :reveal calendar-popup-open
    :transition "slidedown"  
    :duration "250ms"
    (box
      :orientation "v"
      :halign "center"
      :space-evenly false
      (box
        :class "calendar-popup-time-date-box"
        :orientation "v"
        :halign "center"
        (label
          :class "popup-time"
          :text {datetime.time}
        )
        (label
          :class "popup-date"
          :text {datetime.date}
        )
      )
      (box
        :class "calendar-box"
        :orientation "v"
        (calendar
          :class "calendar"
          :show-details false
          :show-heading true
          :show-day-names true
          :show-week-numbers false
          :onclick "echo selected: {0}/{1}/{2}"
        )
      )
    )
  )
)