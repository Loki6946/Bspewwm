(defpoll time-data :interval "10s" 
        "date '+%A, %B %e, %H:%M'")

(defwidget time []
  (box 
    :class "time-widget"
    :halign "center"
    :hexpand true
    :orientation "h"
    (button 
      :orientation "h"
      :class "time-button"
      (label
        :class "time-text"
        :text {time-data}
      )
    )
  )
)