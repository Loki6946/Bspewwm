(defpoll datetime
  :interval "10s"
  "date '+{\"time\":\"%H:%M\",\"date\":\"%a, %B %e\"}'"
)

(defvar calendar-popup-open false)

(defwidget time []
  (box 
    :orientation "h"
    :hexpand true
    (button 
      :class "time-trigger"
      :onclick "scripts/calendar-toggle.sh"
      (label
        :class "time-trigger-text"
        :text {datetime.time}
      )
    )
  )
)

(defwindow calendar-popup
  :monitor 0
  :geometry (geometry
    :x "-5px"
    :y "35px"
    :width "220px"
    :anchor "top right")
  :stacking "fg"
  (calendar-popup-widget)
)

(defwidget calendar-popup-widget []
  (box
    :orientation "v"
    :halign "center"
    :space-evenly false
    (box
      :class "calendar-popup-date-box"
      :orientation "h"
      :halign "fill"
      (label
        :class "calendar-popup-date"
        :halign "start"
        :text {datetime.date}
      )
      (label
        :class "calendar-popup-icon"
        :halign "end"
        :text ""
      )
    )
    (box
      :class "calendar-box"
      :orientation "v"
      (calendar
        :class "calendar"
        :show-details false
        :show-heading true
        :show-day-names true
        :show-week-numbers false
        :onclick "echo selected: {0}/{1}/{2}"
      )
    )
  )
)