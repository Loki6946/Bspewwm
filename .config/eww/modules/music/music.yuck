(deflisten music-data
  :initial '{"name": "", "title": "", "artist": "", "artUrl": "", "status": "Stopped", "length": "", "lengthStr": ""}'
  "scripts/music.sh")

; (defpoll music-length   
;   :interval "2s"
;   "playerctl metadata mpris:length | awk '{print $1 / 1000000}' || echo 1")

; (defpoll music-position
;   :interval "1s" 
;   "playerctl position || echo 0")

; (defpoll formatted-position 
;   :interval "1s" 
;   "playerctl position -f '{{duration(position)}}' || echo '0:00'")

; (defvar music-popup-open false)

(defwidget music []
  (box
    :class "music-widget"
    :orientation "h"
    :space-evenly false
    :spacing 10
    :visible {music-data.status != "Stopped" && music-data.title != ""}

    ; album art
    (box
      :class "music-art"
      :orientation "h"
      :style "background-image: url('${music-data.artUrl}');"
      :space-evenly false   
    )

    ; title + artist
    (button
      :onclick "scripts/music-popup-toggle.sh"
      (label
        :class "music-title"
        :limit-width 200
        :halign "start"
        :text `${music-data.title} - ${music-data.artist}`
      )
    )

    ; controls
    (box
      :class "music-btn-box"
      :orientation "h"
      :valign "center"
      :spacing 8
      (button
        :class "music-btn"
        :onclick "playerctl previous"
        (label
          :class "music-btn-icon"
          :text ""
        )
      )
      (button
        :class "music-btn"
        :onclick "playerctl play-pause"
        (label
          :class {music-data.status == "Playing" ? "music-btn-icon play" : "music-btn-icon pause"}
          :text {music-data.status == "Playing" ? "" : ""}
        )
      )
      (button
        :class "music-btn"
        :onclick "playerctl next"
        (label
          :class "music-btn-icon"
          :text ""
        )
      )
    )
  )
)

