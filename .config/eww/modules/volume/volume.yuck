(deflisten volume-data 
  :initial "0"
  "scripts/volume.sh"
)

(defvar vol-popup-open false)

; volume icon on bar
(defwidget volume []
  (box 
    :orientation "h"
    :halign "center"
    (button 
      :class "volume-button"
      :orientation "h"
      :onclick "scripts/vol-popup-toggle.sh"
      (label
        :class "volume-icon"
        :yalign 0.6
        :text {volume-data == "muted" ? "" : volume-data < 33 ? "" : volume-data < 50 ? "" : ""}
      )
    )
  )
)

; volume popup window
(defwindow vol-popup
  :monitor 0
  :geometry (geometry
    :x "-5px"      
    :y "35px"     
    :width "200px"
    :height "0px"
    :anchor "top right")   
  :stacking "fg"
  (vol-popup-widget)
)

; volume popup content
(defwidget vol-popup-widget []
  (revealer
    :reveal vol-popup-open
    :transition "slidedown"  
    :duration "250ms"

    ; volume level/mute button
    (box
      :orientation "h"
      :space-evenly false
      :halign "center"
      :spacing 10
      (button
        :class "vol-popup-button"
        :onclick "pamixer -t" 
        (label
          :class "vol-popup-icon"
          :xalign {volume-data == "muted" ? 0.45 : 0.5}
          :yalign {volume-data == "muted" ? 0.5 : 0.5}
          :text {volume-data == "muted" ? "" : volume-data}
        )
      )

      ; volume slider
      (overlay 
        :halign "start"
        :hexpand true
        (scale
          :class "vol-popup-slider"
          :orientation "h"
          :width 150
          :min 0
          :max 101
          :active {volume-data != "muted"}
          :value {volume-data == "muted" ? 0 : volume-data}
          :onchange "pamixer --set-volume {}"
        )
        (label
          :class "vol-popup-slider-icon"
          :xalign 0.06
          :text ""
        )
      )
    )
  )
)