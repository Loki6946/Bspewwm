(include "modules/workspaces/workspaces.yuck")
(include "modules/time/time.yuck")
(include "modules/volume/volume.yuck")
(include "modules/network/network.yuck")
(include "modules/powermenu/powermenu.yuck")
(include "modules/music/music.yuck")

(defwidget bar []
  (box 
    :orientation "h"
    :space-evenly true 
    (box 
      :orientation "h" 
      :space-evenly false 
      :halign "start"
      :spacing 5
      (powermenu)
      (workspaces)
    )
    (box 
      :orientation "h" 
      :space-evenly false 
      :halign "center"
      (music)
    )
    (box 
      :orientation "h" 
      :space-evenly false 
      :halign "end"
      :spacing 5
      (volume)
      (network)
      (time)
    )
  )
)

(defwindow bar
  :monitor 0
  :windowtype "desktop"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "10px"
                      :anchor "top center")
  :stacking "bg"
  :reserve (struts :side "top" :distance "4%")
  (bar))
