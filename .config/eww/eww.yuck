(include "modules/workspaces/workspaces.yuck")
(include "modules/time/time.yuck")
(include "modules/volume/volume.yuck")
(include "modules/network/network.yuck")
(include "modules/powermenu/powermenu.yuck")
(include "modules/music/music.yuck")
(include "modules/keyboard/keyboard.yuck")
(include "modules/color-picker/color-picker.yuck")
(include "modules/search/search.yuck")
(include "modules/screenshot/screenshot.yuck")
(include "modules/sysinfo/sysinfo.yuck")
(include "modules/settings/settings.yuck")
(include "modules/wallpaper-picker/wallpaper-picker.yuck")
(include "modules/notifications/notifications.yuck")


(defwidget bar []
  (box 
    :orientation "h"
    :space-evenly true 
    (box 
      :orientation "h" 
      :space-evenly false 
      :halign "start"
      :spacing 4
      (powermenu)
      (sysinfo)
      (workspaces)
    )
    (box 
      :orientation "h" 
      :space-evenly false 
      :halign "center"
      (music)
    )
    (box 
      :orientation "h" 
      :space-evenly false 
      :halign "end"
      :spacing 4
      (keyboard)
      (box
        :orientation "h"
        :space-evenly false
        :spacing 4
        (box
          :orientation "h"
          :space-evenly false
          (search)
          (screenshot)
          (color-picker)
        )
        (box
          :orientation "h"
          :space-evenly false
          :spacing 4
          (volume)
          (network)
        )
      )
      (time)
    )
  )
)

(defwindow bar
  :monitor 0
  :windowtype "desktop"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "4%"
                      :anchor "top center")
  :stacking "bg"
  :reserve (struts :side "top" :distance "4%")
  (bar))