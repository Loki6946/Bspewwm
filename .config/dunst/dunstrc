[global]
    width = 1
    height = 1
    offset = 1x1
    origin = top-right
    transparency = 100
    corner_radius = 0
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/
    script = ~/.config/eww/scripts/notification-add.sh
    
    # disable deduplication
    stack_duplicates = false
    hide_duplicate_count = true
    
    # force each notification to be unique
    markup = no

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
